;; GHOST HACKER: TIME MACHINE — time-axis exploration RPG core (ADR-2607023200).
;; Pure .cljc log-depth/state engine + sample data only. Rendering/input
;; host adapters are a separate layer (see README).
{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :kotoba {:extra-deps {io.github.kotoba-lang/amu
                        {:git/url "https://github.com/kotoba-lang/amu.git"
                         :git/sha "b3a29de4d0e525e6bacd4b66dafc755a2f68536e"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.09.27"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  ;; Browser host adapter (ADR-2607100900 follow-up (b)): plain reagent
  ;; over the pure core, no re-frame (a single local atom is enough for
  ;; one expedition run) -- mirrors kami-mangaka-reader's :cljs alias shape.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent           {:mvn/version "1.2.0"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}}}}}
